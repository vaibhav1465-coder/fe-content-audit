# Copy to .env.local for local testing (never commit .env.local).
# In production, set these in Vercel: Project Settings > Environment Variables

ANTHROPIC_API_KEY=sk-ant-your-key-here

# Password your team types in to use the tool - just make one up yourself
APP_PASSWORD=choose-a-strong-shared-password

# Random signing secret - generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=paste-a-generated-random-string-here

# From Supabase: Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

PER_MINUTE_LIMIT_PER_IP=15
DAILY_REQUEST_CAP=500

# Set to your real Vercel URL after first deploy, e.g. https://fe-content-audit.vercel.app
ALLOWED_ORIGIN=*
