# Copy to .env.local for local testing (never commit .env.local).
# In production, set these in Vercel: Project Settings > Environment Variables

ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_LOW_COST_MODEL=claude-haiku-4-5-20251001

# Optional: override the default preprod WordPress source used for segment/article retrieval
PREPROD_WP_BASE=https://preprod.financialexpress.com/wp-json/wp/v2
PREPROD_COAUTHORS_BASE=https://preprod.financialexpress.com/wp-json/coauthors/v1

# Strong shared password used to access FE Content Audit
APP_PASSWORD=choose-a-strong-shared-password

# Random signing secret. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=paste-a-generated-random-string-here

# From Supabase: Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

PER_MINUTE_LIMIT_PER_IP=15
DAILY_REQUEST_CAP=500
MAX_BODY_TEXT_CHARS=8000
MAX_ARTICLE_PAYLOAD_CHARS=12000

# Set to your real Vercel URL after first deploy, e.g. https://fe-content-audit.vercel.app
ALLOWED_ORIGIN=*
